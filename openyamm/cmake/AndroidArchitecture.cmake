include_guard(GLOBAL)

function(openyamm_android_ffmpeg_architecture abi archVariable prefixVariable)
    if (abi STREQUAL "arm64-v8a")
        set(arch "aarch64")
        set(prefix "aarch64-linux-android")
    elseif (abi STREQUAL "armeabi-v7a")
        set(arch "arm")
        set(prefix "armv7a-linux-androideabi")
    elseif (abi STREQUAL "x86_64")
        set(arch "x86_64")
        set(prefix "x86_64-linux-android")
    else()
        message(FATAL_ERROR "Unsupported Android ABI for FFmpeg: ${abi}")
    endif()
    set(${archVariable} "${arch}" PARENT_SCOPE)
    set(${prefixVariable} "${prefix}" PARENT_SCOPE)
endfunction()
